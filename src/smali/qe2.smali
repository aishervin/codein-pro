    const-string v6, "\nuniform shader field;\nuniform float4 grid;\nuniform float4 origin;\nuniform float4 state;\nuniform float4 window;\nuniform float4 mainTint;\nuniform float4 mainCore;\nuniform float4 alertTint;\nuniform float4 alertCore;\n\nfloat connectionWindow(float x, float W, float4 w) {\n  float t = clamp(min(x - w.x, (W - x) - w.z) / max(w.y, 1.0), 0.0, 1.0);\n  return t * t * (3.0 - 2.0 * t);\n}\n\nhalf4 main(float2 position) {\n  float pitch = grid.x;\n  float cols = grid.y;\n  float rows = grid.z;\n  float sc = grid.w;\n  float2 o = origin.xy;\n  float2 S = origin.zw;\n  bool dark = state.x > 0.5;\n\n  float2 g = (position - o) / pitch;\n  float2 cell = floor(g);\n  if (cell.x < 0.0 || cell.y < 0.0 || cell.x >= cols || cell.y >= rows) return half4(0.0);\n  float2 ctr = o + (cell + 0.5) * pitch;\n  float d = length(position - ctr);\n  float4 f = float4(field.eval(cell + 0.5));\n  f.xy = f.xy * state.z;\n\n  // Fade out toward the box\'s rounded rim, so the box stays the only edge.\n  float2 pt = ctr / sc;\n  float rr = min(window.w, min(S.x, S.y) * 0.5);\n  float2 q = abs(pt - S * 0.5) - (S * 0.5 - float2(rr));\n  float cap = rr - length(max(q, float2(0.0))) - min(max(q.x, q.y), 0.0);\n  float mask = smoothstep(2.0, 6.5, cap);\n  float win = connectionWindow(pt.x, S.x, window);\n  float yn = abs(pt.y - S.y * 0.5) / (S.y * 0.5);\n\n  float ia = f.x;\n  float im = f.y;\n  float tot = ia + im;\n  float P = clamp(1.0 - (1.0 - min(ia, 1.0)) * (1.0 - min(im, 1.0)), 0.0, 1.0);\n  float fresh = f.z;\n\n  // Unlit LEDs: a faint grid, fading toward the top and bottom.\n  float a0 = (dark ? 0.06 : 0.075) * (1.0 - 0.7 * smoothstep(0.35, 0.95, yn)) * state.y;\n  float top = dark ? 0.96 : 1.0;\n  float alpha = a0 + (top - a0) * pow(max(P, 1e-5), (dark ? 0.9 : 0.75) * mix(1.4, 1.0, fresh));\n  float rad = (0.25 + 0.17 * pow(max(P, 1e-5), 0.6)) * mix(1.0, mix(0.82, 1.0, fresh), smoothstep(0.03, 0.2, P)) * pitch;\n  float cov = clamp(rad - d + 0.5, 0.0, 1.0);\n  float halo = 0.22 * P * P * exp(-max(d - rad, 0.0) / (0.12 * pitch)) * (1.0 - cov);\n  alpha = (alpha * cov + halo) * mask * win;\n\n  float core = clamp(P * P * 1.1, 0.0, 0.9) * mix(0.3, 1.0, fresh);\n  float3 cm = mix(mainTint.rgb, mainCore.rgb, core);\n  float3 ca = mix(alertTint.rgb, alertCore.rgb, core);\n  float own = tot > 0.02 ? ia / tot : 0.0;\n  float3 col = mix(cm, ca, own);\n  return half4(half3(col * alpha), half(alpha));\n}\n"

